{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "website_intake_id": {
      "type": "string",
      "description": "Related website ID"
    },
    "segment_id": {
      "type": "string",
      "description": "Target user segment"
    },
    "campaign_name": {
      "type": "string",
      "description": "Campaign name"
    },
    "subject_line": {
      "type": "string",
      "description": "Email subject"
    },
    "email_body": {
      "type": "string",
      "description": "Email content"
    },
    "cta_text": {
      "type": "string",
      "description": "Call-to-action text"
    },
    "cta_url": {
      "type": "string",
      "description": "CTA destination URL"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When to send"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent",
        "cancelled"
      ],
      "default": "draft",
      "description": "Campaign status"
    },
    "sent_count": {
      "type": "number",
      "default": 0,
      "description": "Emails sent"
    },
    "open_rate": {
      "type": "number",
      "description": "Open rate percentage"
    },
    "click_rate": {
      "type": "number",
      "description": "Click rate percentage"
    }
  },
  "required": [
    "website_intake_id",
    "campaign_name",
    "subject_line",
    "email_body"
  ]
}