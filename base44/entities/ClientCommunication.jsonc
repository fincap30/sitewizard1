{
  "name": "ClientCommunication",
  "type": "object",
  "properties": {
    "website_intake_id": {
      "type": "string",
      "description": "Related website ID"
    },
    "client_email": {
      "type": "string",
      "format": "email",
      "description": "Client email"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "project_update",
        "milestone_complete",
        "feedback_request",
        "issue_resolution",
        "payment_reminder"
      ],
      "description": "Template type"
    },
    "subject": {
      "type": "string",
      "description": "Email subject"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When sent"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent"
      ],
      "default": "draft",
      "description": "Status"
    }
  },
  "required": [
    "website_intake_id",
    "client_email",
    "template_type",
    "subject",
    "message"
  ]
}