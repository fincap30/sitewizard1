{
  "name": "WebsiteComment",
  "type": "object",
  "properties": {
    "website_intake_id": {
      "type": "string",
      "description": "Related website intake ID"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Comment author email"
    },
    "user_name": {
      "type": "string",
      "description": "Comment author name"
    },
    "page_reference": {
      "type": "string",
      "description": "Which page the comment is about"
    },
    "section_reference": {
      "type": "string",
      "description": "Which section the comment refers to"
    },
    "comment_text": {
      "type": "string",
      "description": "The comment content"
    },
    "comment_type": {
      "type": "string",
      "enum": [
        "feedback",
        "question",
        "change_request",
        "approval"
      ],
      "default": "feedback",
      "description": "Type of comment"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "in_progress"
      ],
      "default": "open",
      "description": "Comment status"
    },
    "admin_response": {
      "type": "string",
      "description": "Admin response to comment"
    }
  },
  "required": [
    "website_intake_id",
    "user_email",
    "comment_text"
  ]
}