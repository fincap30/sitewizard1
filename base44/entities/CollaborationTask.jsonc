{
  "name": "CollaborationTask",
  "type": "object",
  "properties": {
    "website_intake_id": {
      "type": "string",
      "description": "Related website ID"
    },
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "Task description"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "AI-suggested priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "review",
        "completed"
      ],
      "default": "todo",
      "description": "Task status"
    },
    "assigned_to": {
      "type": "string",
      "description": "Assigned user email"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date"
    },
    "ai_reasoning": {
      "type": "string",
      "description": "AI reasoning for priority"
    }
  },
  "required": [
    "website_intake_id",
    "title"
  ]
}